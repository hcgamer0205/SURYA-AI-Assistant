# GEMINI_API_KEY: Required server-side secret for Gemini AI API calls.
# Never prefix with VITE_ and never expose in client bundles or APK assets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Express HTTP port (Cloud Run injects 8080; local dev defaults to 3000).
PORT=3000

# APP_URL: Deployed public HTTPS backend origin (used for CORS allowlist).
APP_URL="https://your-surya-backend.run.app"

# ALLOWED_ORIGINS: Optional comma-separated list of trusted web origins.
ALLOWED_ORIGINS="https://your-surya-web.example.com"

# SURYA_API_TOKEN: Optional shared bearer secret required from Android/web clients when set.
SURYA_API_TOKEN=""

# VITE_API_BASE_URL: Build-time remote HTTPS backend base URL embedded into Android APK builds.
VITE_API_BASE_URL="https://your-surya-backend.run.app"
